// doneram's own pinned versions, checked with doneram itself. Each site is a
// literal in a file that consumes it. go.mod's own module directives are out
// of scope: doneram doesn't manage Go module dependency versions, only
// literal pins in text files.
//
// A site that matches a different number of times than `expect` fails the
// run. A pattern that silently stops matching is how a pin goes stale
// unnoticed.

amends "package://github.com/kyleking/doneram/releases/download/v0.6.0/doneram@0.6.0#/Config.pkl"
import "package://github.com/kyleking/doneram/releases/download/v0.6.0/doneram@0.6.0#/Config.pkl"

local ciYml = ".github/workflows/ci.yml"
local bumpYml = ".github/workflows/bump_version.yml"
local freshnessYml = ".github/workflows/freshness.yml"
local miseToml = "mise.toml"

/// A `uses: owner/repo@<sha> # <tag>` GitHub Action pin, one capture group
/// spanning the sha and the tag together, since github-action patches both
/// as a single resolved value.
local function actionPin(action: String, sourceFile: String, count: Int): Config.Site = new {
  file = sourceFile
  pattern = #"\#(action)@([0-9a-f]{40} # v[\d.]+)"#
  expect = count
}

tools = new {
  ["checkout"] = new {
    resolver = "github-action"
    resolverName = "actions/checkout"
    sites = new {
      actionPin("actions/checkout", ciYml, 2)
      actionPin("actions/checkout", bumpYml, 1)
      actionPin("actions/checkout", freshnessYml, 1)
    }
  }
  ["commitizen-action"] = new {
    resolver = "github-branch"
    resolverName = "commitizen-tools/commitizen-action@master"
    sites = new {
      new Config.Site {
        file = bumpYml
        pattern = #"commitizen-tools/commitizen-action@([0-9a-f]{40}) # master"#
      }
    }
  }
  ["create-github-app-token"] = new {
    resolver = "github-action"
    resolverName = "actions/create-github-app-token"
    sites = new { actionPin("actions/create-github-app-token", freshnessYml, 1) }
  }
  ["create-pull-request"] = new {
    resolver = "github-action"
    resolverName = "peter-evans/create-pull-request"
    sites = new { actionPin("peter-evans/create-pull-request", freshnessYml, 1) }
  }
  ["doneram-schema"] = new {
    resolver = "github-release"
    resolverName = "kyleking/doneram"
    sites = new {
      new Config.Site {
        file = ".doneram.pkl"
        pattern = #"releases/download/v([\d.]+)/doneram"#
      }
      new Config.Site {
        file = ".doneram.pkl"
        pattern = #"doneram@([\d.]+)#/Config\.pkl"#
      }
    }
  }
  ["go"] = new {
    resolverName = "go"
    sites = new {
      new Config.Site {
        file = ciYml
        pattern = #"go-version: '([\d.]+)'"#
        expect = 2
      }
    }
  }
  ["golangci-lint"] = new {
    resolverName = "go:github.com/golangci/golangci-lint/v2/cmd/golangci-lint"
    sites = new {
      new Config.Site {
        file = miseToml
        pattern = #""go:github\.com/golangci/golangci-lint/v2/cmd/golangci-lint" = "([\d.]+)""#
      }
      new Config.Site {
        file = ciYml
        pattern = #"version: v([\d.]+)"#
      }
    }
  }
  ["golangci-lint-action"] = new {
    resolver = "github-action"
    resolverName = "golangci/golangci-lint-action"
    sites = new { actionPin("golangci/golangci-lint-action", ciYml, 1) }
  }
  ["goreleaser-action"] = new {
    resolver = "github-action"
    resolverName = "goreleaser/goreleaser-action"
    sites = new { actionPin("goreleaser/goreleaser-action", bumpYml, 1) }
  }
  ["mise-action"] = new {
    resolver = "github-action"
    resolverName = "jdx/mise-action"
    sites = new {
      actionPin("jdx/mise-action", ciYml, 1)
      actionPin("jdx/mise-action", bumpYml, 1)
      actionPin("jdx/mise-action", freshnessYml, 1)
    }
  }
  ["pkl"] = new {
    sites = new {
      new Config.Site {
        file = miseToml
        pattern = #"pkl = "([\d.]+)""#
      }
    }
  }
  ["setup-go"] = new {
    resolver = "github-action"
    resolverName = "actions/setup-go"
    sites = new {
      actionPin("actions/setup-go", ciYml, 2)
      actionPin("actions/setup-go", bumpYml, 1)
      actionPin("actions/setup-go", freshnessYml, 1)
    }
  }
  ["upload-artifact"] = new {
    resolver = "github-action"
    resolverName = "actions/upload-artifact"
    sites = new { actionPin("actions/upload-artifact", ciYml, 1) }
  }
}
